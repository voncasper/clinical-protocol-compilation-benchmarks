 /><CodeListItem CodedValue="DRUG_WITHDRAWN" Decode="Drug Permanently Withdrawn" /><CodeListItem CodedValue="NOT_APPLICABLE" Decode="Not Applicable" /></CodeList><CodeList OID="CL.ROUTE" Name="Route of Administration Codelist" DataType="text"><CodeListItem CodedValue="IV" Decode="Intravenous" /><CodeListItem CodedValue="PO" Decode="Oral" /><CodeListItem CodedValue="SC" Decode="Subcutaneous" /><CodeListItem CodedValue="IM" Decode="Intramuscular" /><CodeListItem CodedValue="TOPICAL" Decode="Topical / Cutaneous" /></CodeList><CodeList OID="CL.FREQ" Name="Dosing Frequency Codelist" DataType="text"><CodeListItem CodedValue="QD" Decode="Once Daily (QD)" /><CodeListItem CodedValue="BID" Decode="Twice Daily (BID)" /><CodeListItem CodedValue="QW" Decode="Once Weekly (QW)" /><CodeListItem CodedValue="Q2W" Decode="Every 2 Weeks (Q2W)" /><CodeListItem CodedValue="Q3W" Decode="Every 3 Weeks (Q3W)" /><CodeListItem CodedValue="PRN" Decode="As Needed (PRN)" /></CodeList><CodeList OID="CL.ECOG" Name="ECOG Performance Status Codelist" DataType="integer"><CodeListItem CodedValue="0" Decode="0 - Fully active, able to carry on all pre-disease performance without restriction" /><CodeListItem CodedValue="1" Decode="1 - Restricted in physically strenuous activity but ambulatory and able to carry out light work" /><CodeListItem CodedValue="2" Decode="2 - Ambulatory and capable of all selfcare but unable to carry out any work activities" /><CodeListItem CodedValue="3" Decode="3 - Capable of only limited selfcare; confined to bed or chair &gt;50% of waking hours" /><CodeListItem CodedValue="4" Decode="4 - Completely disabled; cannot carry on any selfcare" /><CodeListItem CodedValue="5" Decode="5 - Dead" /></CodeList><CodeList OID="CL.ECGINTP" Name="ECG Overall Interpretation Codelist" DataType="text"><CodeListItem CodedValue="NORMAL" Decode="Normal" /><CodeListItem CodedValue="ABNORMAL_NCS" Decode="Abnormal - Not Clinically Significant" /><CodeListItem CodedValue="ABNORMAL_CS" Decode="Abnormal - Clinically Significant" /></CodeList><CodeList OID="CL.LBCLSIG" Name="Laboratory Abnormality &amp; Clinical Significance Codelist" DataType="text"><CodeListItem CodedValue="NORMAL" Decode="Within Normal Limits (WNL)" /><CodeListItem CodedValue="LOW_NCS" Decode="Low - Not Clinically Significant" /><CodeListItem CodedValue="LOW_CS" Decode="Low - Clinically Significant" /><CodeListItem CodedValue="HIGH_NCS" Decode="High - Not Clinically Significant" /><CodeListItem CodedValue="HIGH_CS" Decode="High - Clinically Significant" /></CodeList><CodeList OID="CL.VSPOS" Name="Vital Signs Subject Position Codelist" DataType="text"><CodeListItem CodedValue="SUPINE" Decode="Supine" /><CodeListItem CodedValue="SITTING" Decode="Sitting" /><CodeListItem CodedValue="STANDING" Decode="Standing" /></CodeList><CodeList OID="CL.LAT" Name="Anatomical Laterality Codelist" DataType="text"><CodeListItem CodedValue="LEFT" Decode="Left" /><CodeListItem CodedValue="RIGHT" Decode="Right" /><CodeListItem CodedValue="BILATERAL" Decode="Bilateral" /></CodeList></CodeLists><Derivations><Derivation OID="MT.BSA" Name="Body Surface Area Calculation (Mosteller)" Type="Derivation" Expression="round(((ITEM.HEIGHT * ITEM.WEIGHT) / 3600) ** 0.5, 2)" /><Derivation OID="MT.BMI" Name="Body Mass Index Calculation" Type="Derivation" Expression="round(ITEM.WEIGHT / ((ITEM.HEIGHT / 100) ** 2), 1)" /><Derivation OID="MT.ANC" Name="Absolute Neutrophil Count Calculation" Type="Derivation" Expression="round(ITEM.WBC * (ITEM.NEUT / 100), 2)" /><Derivation OID="MT.BSA_DUBOIS" Name="Body Surface Area (BSA — DuBois &amp; DuBois Formula)" Type="Derivation" Expression="round(0.007184 * (ITEM.WEIGHT ** 0.425) * (ITEM.HEIGHT ** 0.725), 2)" /><Derivation OID="MT.IBW" Name="Ideal Body Weight (IBW — Devine Formula)" Type="Derivation" Expression="round((50.0 if ITEM.SEX == 'M' else 45.5) + 0.9055 * (ITEM.HEIGHT - 152.4), 1)" /><Derivation OID="MT.ABW" Name="Adjusted Body Weight (ABW — Obesity Dosing Cap)" Type="Derivation" Expression="round(ITEM.IBW + 0.4 * max(0.0, ITEM.WEIGHT - ITEM.IBW), 1)" /><Derivation OID="MT.MAP" Name="Mean Arterial Pressure (MAP) Calculation" Type="Derivation" Expression="round(ITEM.DIABP + (ITEM.SYSBP - ITEM.DIABP) / 3.0, 1)" /><Derivation OID="MT.PP" Name="Arterial Pulse Pressure (PP) Calculation" Type="Derivation" Expression="ITEM.SYSBP - ITEM.DIABP" /><Derivation OID="MT.QTCF" Name="Fridericia Rate-Corrected QT Interval (QTcF — ICH E14)" Type="Derivation" Expression="round(ITEM.QT * ((60.0 / ITEM.EGHR) ** (1.0 / 3.0)), 1)" /><Derivation OID="MT.QTCB" Name="Bazett Rate-Corrected QT Interval (QTcB — ICH E14)" Type="Derivation" Expression="round(ITEM.QT * ((60.0 / ITEM.EGHR) ** 0.5), 1)" /><Derivation OID="MT.QTCF_CHG" Name="Longitudinal Change from Baseline in QTcF (Delta-QTcF — ICH E14)" Type="Derivation" Expression="round(ITEM.QTCF - BASELINE.QTCF, 1)" /><Derivation OID="MT.ALC" Name="Absolute Lymphocyte Count (ALC) Calculation" Type="Derivation" Expression="round(ITEM.WBC * (ITEM.LYM / 100.0), 2)" /><Derivation OID="MT.NLR" Name="Neutrophil-to-Lymphocyte Ratio (NLR — Immune Prognostic Index)" Type="Derivation" Expression="round(ITEM.ANC / ITEM.ALC, 2)" /><Derivation OID="MT.ULN_RATIO" Name="Hepatic Enzyme / Bilirubin Upper Limit of Normal Ratio (x ULN)" Type="Derivation" Expression="round(ITEM.ALT / ITEM.ALT_ULN, 2)" /><Derivation OID="MT.AST_ALT_RATIO" Name="De Ritis Hepatic Transaminase Ratio (AST/ALT)" Type="Derivation" Expression="round(ITEM.AST / ITEM.ALT, 2)" /><Derivation OID="MT.HYS_LAW_FLAG" Name="FDA Drug-Induced Liver Injury (Hy's Law) Composite Flag" Type="Derivation" Expression="1 if ((ITEM.ALT / ITEM.ALT_ULN &gt;= 3.0 or ITEM.AST / ITEM.AST_ULN &gt;= 3.0) and (ITEM.TBILI / ITEM.TBILI_ULN &gt;= 2.0)) else 0" /><Derivation OID="MT.FIB4" Name="Fibrosis-4 (FIB-4) Hepatic Fibrosis Index" Type="Derivation" Expression="round((ITEM.AGE * ITEM.AST) / (ITEM.PLT * (ITEM.ALT ** 0.5)), 2)" /><Derivation OID="MT.DOSE_CALC" Name="Protocol Weight / BSA-Adjusted Planned Dose Calculation" Type="Derivation" Expression="round(ITEM.WEIGHT * ITEM.DOSE_LEVEL_MG_KG, 1)" /><Derivation OID="MT.DOSE_INTENSITY" Name="Relative Dose Intensity (RDI %) Calculation" Type="Derivation" Expression="round((ITEM.EXDOSE / ITEM.EXDOSE_PLANNED) * 100.0, 1)" /><Derivation OID="MT.CUM_DOSE" Name="Cumulative Study Drug Exposure Dose (ADEX.CUMDOSE)" Type="Derivation" Expression="round(ITEM.CUM_DOSE_PRIOR + ITEM.EXDOSE, 1)" /><Derivation OID="MT.TREATMENT_COMPLIANCE" Name="Study Treatment Dosing Compliance Percentage (%)" Type="Derivation" Expression="round((ITEM.DOSES_TAKEN / ITEM.DOSES_PLANNED) * 100.0, 1)" /><Derivation OID="MT.RECIST_SOD" Name="RECIST 1.1 Sum of Target Lesion Diameters (SOD)" Type="Derivation" Expression="round(ITEM.TL1_DIAM + ITEM.TL2_DIAM + ITEM.TL3_DIAM, 1)" /><Derivation OID="MT.RECIST_PCT_NADIR" Name="RECIST 1.1 Percent Change from Nadir &amp; Baseline in Target Lesion SOD" Type="Derivation" Expression="round(((ITEM.SOD - ITEM.NADIR_SOD) / ITEM.NADIR_SOD) * 100.0, 1)" /><Derivation OID="MT.AGE_DERIVED" Name="Derived Subject Age at Informed Consent (DM.AGE)" Type="Derivation" Expression="int((ITEM.RFICDTC - ITEM.BRTHDTC).days // 365.25)" /><Derivation OID="MT.STUDY_DAY" Name="CDISC Study Day (--DY, No-Day-0 Convention)" Type="Derivation" Expression="(STUDY_EVENT.VISDAT - ITEM.RFSTDTC).days + (1 if STUDY_EVENT.VISDAT &gt;= ITEM.RFSTDTC else 0)" /><Derivation OID="MT.AEDUR" Name="Adverse Event Duration (ADAE.AEDUR)" Type="Derivation" Expression="(ITEM.AEENDAT - ITEM.AESTDAT).days + 1" /><Derivation OID="MT.TRTDURD" Name="Total Treatment Exposure Duration (ADSL.TRTDURD)" Type="Derivation" Expression="(ITEM.EXENDTC - ITEM.EXSTDTC).days + 1" /><Derivation OID="MT.CHG_BASELINE" Name="ADaM Longitudinal Change &amp; Percent Change from Baseline (CHG / PCHG)" Type="Derivation" Expression="round(((ITEM.AVAL - BASELINE.BASE) / BASELINE.BASE) * 100.0, 1)" /></Derivations><StudyEvents><StudyEvent OID="SE.V01" Name="Pretreatment (Within 4 Wks of Entry)" Type="Scheduled" TargetDays="-14" MinWindowDays="-14" MaxWindowDays="0"><FormRef FormOID="FORM.IE" Mandatory="Yes" /><FormRef FormOID="FORM.IC" Mandatory="Yes" /><FormRef FormOID="FORM.DEMO" Mandatory="Yes" /><FormRef FormOID="FORM.MH" Mandatory="Yes" /><FormRef FormOID="FORM.CM" Mandatory="Yes" /><FormRef FormOID="FORM.VS" Mandatory="Yes" /><FormRef FormOID="FORM.EG" Mandatory="Yes" /><FormRef FormOID="FORM.PE" Mandatory="Yes" /><FormRef FormOID="FORM.LB" Mandatory="Yes" /><FormRef FormOID="FORM.AE" Mandatory="Yes" /><FormRef FormOID="FORM.PREG" Mandatory="Yes" /><FormRef FormOID="FORM.TU" Mandatory="Yes" /></StudyEvent><StudyEvent OID="SE.C1D1" Name="Cycle 1 Day 1" Type="Scheduled" TargetDays="1" MinWindowDays="-3" MaxWindowDays="3" Repeating="true"><FormRef FormOID="FORM.EX" Mandatory="Yes" /><FormRef FormOID="FORM.CM" Mandatory="Yes" /><FormRef FormOID="FORM.PR" Mandatory="Yes" /><FormRef FormOID="FORM.VS" Mandatory="Yes" /><FormRef FormOID="FORM.PE" Mandatory="Yes" /><FormRef FormOID="FORM.LB" Mandatory="Yes" /><FormRef FormOID="FORM.PK" Mandatory="Yes" /><FormRef FormOID="FORM.BS" Mandatory="Yes" /><FormRef FormOID="FORM.AE" Mandatory="Yes" /></StudyEvent><StudyEvent OID="SE.C1D8" Name="Cycle 1 Day 8" Type="Scheduled" TargetDays="8" MinWindowDays="-3" MaxWindowDays="3" Repeating="true"><FormRef FormOID="FORM.EX" Mandatory="Yes" /><FormRef FormOID="FORM.CM" Mandatory="Yes" /><FormRef FormOID="FORM.PR" Mandatory="Yes" /><FormRef FormOID="FORM.VS" Mandatory="Yes" /><FormRef FormOID="FORM.LB" Mandatory="Yes" /><FormRef FormOID="FORM.PK" Mandatory="Yes" /><FormRef FormOID="FORM.BS" Mandatory="Yes" /><FormRef FormOID="FORM.AE" Mandatory="Yes" /></StudyEvent><StudyEvent OID="SE.C1D15" Name="Cycle 1 Day 15" Type="Scheduled" TargetDays="15" MinWindowDays="-3" MaxWindowDays="3" Repeating="true"><FormRef FormOID="FORM.CM" Mandatory="Yes" /><FormRef FormOID="FORM.PR" Mandatory="Yes" /><FormRef FormOID="FORM.VS" Mandatory="Yes" /><FormRef FormOID="FORM.LB" 