mRef FormOID="FORM.PR" Mandatory="Yes" /><FormRef FormOID="FORM.VS" Mandatory="Yes" /><FormRef FormOID="FORM.EG" Mandatory="Yes" /><FormRef FormOID="FORM.PE" Mandatory="Yes" /><FormRef FormOID="FORM.LB" Mandatory="Yes" /><FormRef FormOID="FORM.PK" Mandatory="Yes" /><FormRef FormOID="FORM.BS" Mandatory="Yes" /><FormRef FormOID="FORM.AE" Mandatory="Yes" /><FormRef FormOID="FORM.DS" Mandatory="Yes" /><FormRef FormOID="FORM.PREG" Mandatory="Yes" /><FormRef FormOID="FORM.TU" Mandatory="Yes" /></StudyEvent><StudyEvent OID="SE.FU01" Name="Long-Term Follow-up" Type="Scheduled" TargetDays="57" MinWindowDays="-7" MaxWindowDays="7"><FormRef FormOID="FORM.PR" Mandatory="Yes" /><FormRef FormOID="FORM.PK" Mandatory="Yes" /><FormRef FormOID="FORM.BS" Mandatory="Yes" /><FormRef FormOID="FORM.AE" Mandatory="Yes" /><FormRef FormOID="FORM.DS" Mandatory="Yes" /></StudyEvent></StudyEvents><Rules><RuleDef OID="EC.VS.SYSBP_DIABP" Name="Blood Pressure Physiological Plausibility" Target="FORM.VS.ITEM.SYSBP" ConditionRef="COND.SYSBP_GT_DIABP"><Expression>ITEM.SYSBP &gt; ITEM.DIABP</Expression><RuleAction Type="Discrepancy" Message="Systolic blood pressure must be strictly greater than diastolic blood pressure."><TranslatedText>Systolic blood pressure must be strictly greater than diastolic blood pressure.</TranslatedText></RuleAction></RuleDef><RuleDef OID="EC.PREG.SEX_RESTRICTION" Name="Pregnancy Test Sex Eligibility" Target="FORM.LB.ITEM.HCG" ConditionRef="COND.PREG_FEMALE_ONLY"><Expression>ITEM.SEX == 'F'</Expression><RuleAction Type="Discrepancy" Message="Pregnancy test form may only be populated for female subjects."><TranslatedText>Pregnancy test form may only be populated for female subjects.</TranslatedText></RuleAction></RuleDef><RuleDef OID="EC.PREG.EVEN_CYCLE_SCHEDULE" Name="Pregnancy Test Even Cycle Schedule Compliance" Target="FORM.LB.ITEM.HCG" ConditionRef="COND.PREG_EVEN_CYCLES_AND_BASELINE"><Expression>(ITEM.EX_CYCLE % 2 == 0 and ITEM.EX_DAY == 1) or (STUDY_EVENT.OID in ['SE.V01', 'SE.V05'])</Expression><RuleAction Type="Discrepancy" Message="Pregnancy test is mandated at Screening, Day 1 of even-numbered cycles (C2, C4, C6...), and Study Completion / Discontinuation."><TranslatedText>Pregnancy test is mandated at Screening, Day 1 of even-numbered cycles (C2, C4, C6...), and Study Completion / Discontinuation.</TranslatedText></RuleAction></RuleDef><RuleDef OID="EC.EX.DOSING_DATE_CONCURRENCE" Name="Cycle Dosing Date Concurrence" Target="FORM.EX.ITEM.EXDAT" ConditionRef="COND.EXDAT_EQ_VISDAT"><Expression>ITEM.EXDAT == ITEM.VISDAT</Expression><RuleAction Type="Discrepancy" Message="Dose administration date must coincide with scheduled visit date on Cycle Day 1."><TranslatedText>Dose administration date must coincide with scheduled visit date on Cycle Day 1.</TranslatedText></RuleAction></RuleDef><RuleDef OID="EC.GATE.ANC_CLEARANCE" Name="Pre-Dose ANC Safety Clearance Gate" Target="FORM.LB.ITEM.ANC" ConditionRef="COND.ANC_SAFETY_CLEARANCE"><Expression>ITEM.ANC &gt;= 1.0</Expression><RuleAction Type="Discrepancy" Message="ANC must be &gt;= 1.0 x 10^9/L before initiating next treatment cycle."><TranslatedText>ANC must be &gt;= 1.0 x 10^9/L before initiating next treatment cycle.</TranslatedText></RuleAction></RuleDef><RuleDef OID="EC.AE.DATE_CHRONOLOGY" Name="Adverse Event Date Chronology Check" Target="FORM.AE.ITEM.AEENDAT" ConditionRef="COND.AE_START_LE_END"><Expression>ITEM.AESTDAT &lt;= ITEM.AEENDAT</Expression><RuleAction Type="Discrepancy" Message="Adverse event resolution date must be on or after adverse event start date."><TranslatedText>Adverse event resolution date must be on or after adverse event start date.</TranslatedText></RuleAction></RuleDef><RuleDef OID="EC.GATE.GRADE3_DOSE_DELAY" Name="Grade 3+ Toxicity Dose Modification Gate" Target="FORM.AE.ITEM.AETOXGR" ConditionRef="COND.AE_GRADE3_DOSE_DELAY"><Expression>ITEM.AETOXGR &gt;= 3</Expression><RuleAction Type="Discrepancy" Message="CTCAE Grade 3 or higher toxicity reported; requires completion of Dose Modification form."><TranslatedText>CTCAE Grade 3 or higher toxicity reported; requires completion of Dose Modification form.</TranslatedText></RuleAction></RuleDef><RuleDef OID="EC.AE.FATAL_DISPOSITION_SYNC" Name="Fatal AE Disposition Concurrence" Target="FORM.AE.ITEM.AEOUT" ConditionRef="COND.AE_FATAL_DISPOSITION_SYNC"><Expression>ITEM.AEOUT == '4' or ITEM.AETOXGR == '5'</Expression><RuleAction Type="Discrepancy" Message="Fatal adverse event outcome requires subject disposition to be recorded as Death on FORM.DS."><TranslatedText>Fatal adverse event outcome requires subject disposition to be recorded as Death on FORM.DS.</TranslatedText></RuleAction></RuleDef></Rules></VeevaCDMS>